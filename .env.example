# WebRTC ICE/TURN configuration (production)
# Use multiple TURN URLs so restrictive networks can still connect.
# Include both UDP and TLS-over-443 transports.
VITE_TURN_URLS=turn:your.turn.host:3478?transport=udp,turns:your.turn.host:443?transport=tcp
VITE_TURN_USERNAME=turnuser
VITE_TURN_CREDENTIAL=turnpass

# Backward compatibility for older config keys (optional)
# VITE_TURN_URL=turn:your.turn.host:3478

# Set to true only for diagnostics/testing to force TURN relay for all calls
# VITE_WEBRTC_FORCE_RELAY=false

# Supabase Edge Function secrets for ephemeral TURN credentials
# Configure these with `supabase secrets set ...` (do not expose in VITE_ env).
# EXPRESSTURN_ICE_URLS=turn:relay1.expressturn.com:3480?transport=udp,turn:relay1.expressturn.com:3480?transport=tcp,turns:relay1.expressturn.com:443?transport=tcp
# EXPRESSTURN_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# EXPRESSTURN_TTL_SECONDS=3600
# For ExpressTURN paid plans with shared-secret auth (preferred):
# EXPRESSTURN_SECRET_KEY=your_expressturn_shared_secret
# For ExpressTURN free plans (static dashboard credentials):
# EXPRESSTURN_USERNAME=your_dashboard_turn_username
# EXPRESSTURN_PASSWORD=your_dashboard_turn_password

# Paystack Payment Gateway
# Get your keys from https://dashboard.paystack.com/#/settings/developer
# IMPORTANT: For production deployments, add your domain to Paystack's whitelist
# Go to Paystack Dashboard > Settings > Developer > Domain URL to add your production domain
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Optional: Disable Paystack on remote (for testing purposes only)
# Set to "true" to disable Paystack on remote deployments (not recommended for production)
# VITE_PAYSTACK_DISABLE_REMOTE=false
