# Example Vite environment variables for TURN
# Replace with your TURN server URL and credentials
VITE_TURN_URL=turn:your.turn.host:3478
VITE_TURN_USERNAME=turnuser
VITE_TURN_CREDENTIAL=turnpass

# Optional: if you use TLS (turns)
# VITE_TURN_URL=turns:your.turn.host:5349

# Paystack Payment Gateway
# Get your keys from https://dashboard.paystack.com/#/settings/developer
# IMPORTANT: For production deployments, add your domain to Paystack's whitelist
# Go to Paystack Dashboard > Settings > Developer > Domain URL to add your production domain
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
